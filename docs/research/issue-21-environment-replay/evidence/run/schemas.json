{
  "EnvironmentRequirement": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "environment-research/v1"
      },
      "os": {
        "type": "string"
      },
      "node": {
        "type": "string"
      },
      "cli": {
        "type": "string"
      },
      "skillDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "policyDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "networkCapability": {
        "type": "string"
      },
      "storageDurability": {
        "type": "string"
      },
      "localOnlyResources": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "LAN",
            "DEVICE",
            "BROWSER_STATE",
            "WINDOWS_APP"
          ]
        }
      },
      "requiredEffect": {
        "type": "string",
        "const": "DENY"
      },
      "explicitSelection": {
        "type": "boolean",
        "const": true
      },
      "budget": {
        "type": "object",
        "properties": {
          "budgetRef": {
            "type": "string",
            "const": "fixture-budget:authoritative"
          },
          "policyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ledgerRef": {
            "type": "string",
            "const": "fixture-ledger:source-git-common-dir"
          },
          "ledgerIdentityDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "costClass": {
            "type": "string",
            "const": "LOCAL_SYNTHETIC_ZERO_PROVIDER_COST"
          },
          "reservationUsd": {
            "type": "number",
            "minimum": 0
          },
          "hardUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "budgetRef",
          "policyHash",
          "ledgerRef",
          "ledgerIdentityDigest",
          "costClass",
          "reservationUsd",
          "hardUsd"
        ],
        "additionalProperties": false
      },
      "principal": {
        "type": "object",
        "properties": {
          "principalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]{1,120}$"
          },
          "parentPrincipalId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9:_-]{1,120}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "leaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]{1,120}$"
          },
          "executionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]{1,120}$"
          },
          "credentialRef": {
            "type": "string",
            "pattern": "^fixture-ref:[A-Z]{1,16}$"
          },
          "identityIsolation": {
            "type": "string",
            "enum": [
              "MOCK_DEDICATED",
              "SHARED",
              "UNKNOWN"
            ]
          },
          "scope": {
            "type": "string",
            "const": "MOCK_AUTHORITY_ONLY"
          }
        },
        "required": [
          "principalId",
          "parentPrincipalId",
          "leaseId",
          "executionId",
          "credentialRef",
          "identityIsolation",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "schemaVersion",
      "os",
      "node",
      "cli",
      "skillDigest",
      "policyDigest",
      "networkCapability",
      "storageDurability",
      "localOnlyResources",
      "requiredEffect",
      "explicitSelection",
      "budget",
      "principal"
    ],
    "additionalProperties": false
  },

  "HandoffReceipt": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "environment-research/v1"
      },
      "bundleId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9:_-]{1,120}$"
      },
      "bundleDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "targetObservationDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "requirementDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "state": {
        "type": "string",
        "enum": [
          "RESUMED_VERIFIED",
          "ENVIRONMENT_MISMATCH",
          "LOCAL_ONLY",
          "UNKNOWN",
          "DIVERGED",
          "DENIED",
          "BUDGET_BLOCKED",
          "UNSUPPORTED_PENDING_CONTROL",
          "HOST_BOUND_CHECKPOINT"
        ]
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "expected": {},
            "actual": {}
          },
          "required": [
            "name",
            "ok",
            "expected",
            "actual"
          ],
          "additionalProperties": false
        }
      },
      "declaredEffectDecision": {
        "type": "string",
        "enum": [
          "DENY",
          "ALLOW",
          "UNKNOWN"
        ]
      },
      "effectDecision": {
        "type": "string",
        "const": "DENY"
      },
      "effectScope": {
        "type": "string",
        "const": "SYNTHETIC_FAIL_CLOSED_GATE_ONLY"
      },
      "principalDecision": {
        "type": "string"
      },
      "budgetReport": {},
      "fixtureCommand": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "fixtureExit": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "nativeMigration": {
        "type": "string",
        "const": "UNKNOWN"
      },
      "reviewGate": {
        "type": "string",
        "const": "NOT_RUN"
      },
      "providerCalls": {
        "type": "number",
        "const": 0
      },
      "networkAttempts": {
        "type": "number",
        "const": 0
      },
      "receiptDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "schemaVersion",
      "bundleId",
      "bundleDigest",
      "targetObservationDigest",
      "requirementDigest",
      "state",
      "checks",
      "declaredEffectDecision",
      "effectDecision",
      "effectScope",
      "principalDecision",
      "budgetReport",
      "fixtureCommand",
      "fixtureExit",
